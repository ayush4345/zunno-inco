NEXT_PUBLIC_BASE_SEPOLIA_CONTRACT_ADDRESS=0x1138A6984cCBAa8b09a10fd24753c0897F65fB70

# ERC2771Forwarder for gasless/no-popup drawCard & playCard (meta-tx relay).
# Leave unset to fall back to direct wallet-signed txs for those two moves.
NEXT_PUBLIC_BASE_SEPOLIA_FORWARDER_ADDRESS=

# Backend base URL — also where the meta-tx relay endpoint lives (/api/relay/forward)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
